# scripts/deploy/docker/Dockerfile.certs
# keel-certs: the complete Mozilla CA bundle (Alpine ca-certificates) as one PEM
# file per root under /certs/, in an otherwise empty (scratch) image.
#
# Nothing here is trusted by itself. Every keel runtime image is FROM scratch
# and copies an explicit allowlist of roots out of this image into
# /etc/ssl/certs/ (see Dockerfile and Dockerfile.release). Build it first with
# scripts/build/build-certs-image.sh (make build-certs-image).

FROM alpine:3.22@sha256:49340b346798875b5592e5d420241f2f9cfba5f47e62ebb1446a1b34734e898f AS source
RUN apk add --no-cache ca-certificates

FROM scratch
COPY --from=source /usr/share/ca-certificates/mozilla/ /certs/
