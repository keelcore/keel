# tests/mockupstream/Containerfile
# Mock upstream for the sidecar integration tests: packages the binary
# scripts/build/build-mockupstream-image.sh compiles from this tree in the dev
# image (keel as a library, no tag needed). Its build context is that binary's
# directory, target/mockupstream. Built by both test stacks:
# docker-compose.test.yaml (CI) and scripts/container/test-container-stack.sh (local).
FROM scratch
COPY mockupstream /mockupstream
USER 65532:65532
ENTRYPOINT ["/mockupstream"]
