# containers/dev/Containerfile
# keel dev image: the keelcore-standards dev image (Go, Node, shellcheck, bats,
# markdownlint, staticcheck, gitleaks, syft, cosign, govulncheck) plus keel's own build, lint,
# test and release tools, each installed once at build time by its pinned
# scripts/ci/setup-<tool>.sh. Every keel make target that builds or runs a tool
# runs in this image (scripts/dev/run.sh) on every host, with the repository
# mounted read-only and its output directories (containers/writable) writable.
# Build context: the repository root. BASE_DEV_IMAGE: the .standards dev image,
# pinned by digest (scripts/dev/run.sh and scripts/dev/publish.sh pass it).

ARG BASE_DEV_IMAGE
FROM ${BASE_DEV_IMAGE}

WORKDIR /opt/keel
# One cached layer per tool, each copying only its own setup script, so a changed script
# rebuilds only its tool (and the ones after it). timeout turns a stalled download (go has
# no download timeout) into a failed step; a step that fails moves to the end of this list.
COPY scripts/ci/setup-pebble.sh /opt/keel/scripts/ci/
RUN timeout 300 bash scripts/ci/setup-pebble.sh && go clean -modcache -cache

# Test-suite dependencies: nc (the remote-sink BATS) and pebble's module source in the module
# cache (its test CA, read by the ACME end-to-end BATS) — the version setup-pebble.sh pins.
RUN apt-get update \
 && apt-get install -y --no-install-recommends netcat-openbsd \
 && rm -rf /var/lib/apt/lists/* \
 && cd /tmp \
 && go mod download "$(sed -nE "s/^readonly PEBBLE_MODULE='([^@]+)\/cmd\/pebble@([^']+)'\$/\\1@\\2/p" /opt/keel/scripts/ci/setup-pebble.sh)"

WORKDIR /work
